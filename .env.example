# Copiá este archivo a .env.local para desarrollo. NUNCA pongas secretos acá:
# todo lo que empieza con VITE_ termina dentro del bundle público.

# Directorio colaborativo compartido (Supabase). Si se dejan vacías, la app usa
# el directorio local (localStorage) como hasta ahora.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Solo la clave pública (anon / publishable). Jamás la service_role.
VITE_SUPABASE_ANON_KEY=

# URL pública del deploy, para las metas Open Graph/Twitter.
VITE_PUBLIC_SITE_URL=https://tpo-tec-e-inno.vercel.app
